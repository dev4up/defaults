{
	// teste
	"editor.tabSize": 2,
	"editor.insertSpaces": false,
	"editor.detectIndentation": false,
	// Melhorias de visualização do editor
	"editor.guides.bracketPairs": true,
	"editor.bracketPairColorization.enabled": true, // Adicionado para melhor visualização de pares de colchetes
	"editor.wordWrap": "on", // Adicionado para melhor visualização de código extenso
	"editor.formatOnSave": false, // Adicionado para formatação automática ao salvar
	"editor.codeActionsOnSave": {
		"source.fixAll": "never"
	}, // Adiciona correções automáticas ao salvar
	// --- CONFIGURAÇÕES DE AUTO IMPORTAÇÃO (TYPESCRIPT / JAVASCRIPT) ---
	// Ponto e vírgula: A formatação nativa do JS (js.format.semicolons) foi descontinuada.
	"js/ts.format.semicolons": "insert",
	// Aspas: Mantém as aspas simples ativas para os "Auto Imports" e "Quick Fixes" do próprio VS Code,
	// e adiciona a regra do Prettier para garantir as aspas ao salvar/formatar o código:
	"js/ts.preferences.quoteStyle": "single",
	// Inlay Hints (Dicas de tipos e parâmetros):
	// Para que essas três chaves específicas do JavaScript voltem a ser reconhecidas e funcionem,
	// o controle global de Inlay Hints do editor DEVE estar ativado obrigatoriamente.
	"editor.inlayHints.enabled": "on",
	"js/ts.inlayHints.functionLikeReturnTypes.enabled": true,
	"js/ts.inlayHints.parameterNames.enabled": "literals",
	"js/ts.inlayHints.variableTypes.enabled": true,
	// Code Lens (Contador de referências acima das funções):
	// Da mesma forma, o controle global do Code Lens precisa estar ativo
	// para que as duas configurações do JavaScript funcionem sem apresentar alertas.
	"editor.codeLens": true,
	"js/ts.referencesCodeLens.enabled": true,
	"js/ts.referencesCodeLens.showOnAllFunctions": true,
	// Sugestões de Auto Importação:
	// Habilita as sugestões de auto importação no menu do IntelliSense (autocomplete).
	// Quando você digita o nome de uma função/módulo que não foi importado, o VS Code sugere a importação.
	"js/ts.suggest.autoImports": true,
	// Importações via package.json:
	// Controla se o VS Code deve vasculhar as dependências listadas no seu `package.json`
	// para oferecer sugestões de auto importação. O valor "on" força essa busca (o padrão costuma ser "auto").
	"js/ts.preferences.includePackageJsonAutoImports": "on",
	// Estilo do caminho da importação:
	// Força o VS Code a usar caminhos relativos (ex: "./utils/format" ou "../../components/Button")
	// em vez de usar caminhos absolutos ou baseados no baseUrl do projeto quando faz o auto import.
	"js/ts.preferences.importModuleSpecifier": "relative",
	// Define o Prettier como o formatador padrão para JavaScript,
	// permitindo que a regra 1 (semicolons) funcione perfeitamente.
	"[javascript]": {
		"editor.defaultFormatter": "vscode.typescript-language-features"
	},
	"js/ts.implicitProjectConfig.checkJs": true,
	"files.encoding": "iso88591",
	"[jsonl]": {
		"editor.defaultFormatter": "vscode.json-language-features",
		"files.encoding": "utf8"
	},
	"[json]": {
		"editor.defaultFormatter": "vscode.json-language-features",
		"files.encoding": "utf8"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "vscode.json-language-features",
		"files.encoding": "utf8"
	},
	"[php]": {
		"editor.formatOnSave": true, // Ativa formatação automática APENAS para PHP
		"editor.defaultFormatter": "bmewburn.vscode-intelephense-client" // Define Intelephense como formatador padrão
	},
	"[python]": {
		"files.encoding": "utf8"
	},
	"[shellscript]": {
		"files.encoding": "utf8"
	},
	"[markdown]": {
		"files.encoding": "utf8"
	},
	"[yaml]": {
		"editor.insertSpaces": true,
		"editor.tabSize": 2,
		"files.encoding": "utf8",
		"files.eol": "\n",
		"files.insertFinalNewline": true,
		"files.trimTrailingWhitespace": true,
	},
	// Configurações de validação e formatação PHP
	"php.validate.enable": true, // Adicionado para validação de sintaxe PHP
	"php.suggest.basic": true, // Adicionado para melhorar sugestões de código
	"intelephense.completion.fullyQualifyGlobalConstantsAndFunctions": true,
	"intelephense.diagnostics.undefinedClassConstants": false,
	"intelephense.diagnostics.undefinedConstants": false,
	"intelephense.diagnostics.undefinedFunctions": false,
	"intelephense.diagnostics.undefinedMethods": false,
	"intelephense.diagnostics.undefinedProperties": true, // Alterado para true para detectar propriedades inexistentes
	"intelephense.diagnostics.undefinedTypes": false,
	"intelephense.environment.documentRoot": "/var/www/sgs/src",
	"intelephense.environment.phpVersion": "8.2",
	"intelephense.format.braces": "k&r",
	"intelephense.phpdoc.textFormat": "text",
	"intelephense.phpdoc.useFullyQualifiedNames": true,
	"intelephense.rename.exclude": [
		"**/vendor/**",
		"*.js.php"
	],
	// Configurações LESS
	"less.compile": {
		"compress": true,
		"autoprefixer": "last 5 Firefox versions, > 5%, last 4 versions",
		"ieCompat": false
	},
	"less.format.spaceAroundSelectorSeparator": true,
	"less.lint.duplicateProperties": "warning",
	// Gerenciamento de arquivos
	"files.trimFinalNewlines": true,
	"files.trimTrailingWhitespace": true,
	"files.insertFinalNewline": true, // Adicionado para consistência de arquivos
	"files.exclude": {
		"**/node_modules": true,
		"**/vendor": true,
		"**/.git": true,
		"**/.DS_Store": true,
		"**/Thumbs.db": true,
		"**/.~lock.*#": true // Adicionado para excluir os padrões .~lock.*# e */.~lock.*#
	},
	"files.watcherExclude": {
		"**/node_modules/**": true,
		"**/vendor/**": true,
		"**/.git/**": true
	},
	// Git e controle de versão
	"git.autofetch": true,
	"git.confirmSync": false,
	"git.enableSmartCommit": true,
	"diffEditor.ignoreTrimWhitespace": true,
	"peacock.remoteColor": "#156415",
	"workbench.colorCustomizations": {
		"activityBar.activeBackground": "#1e8e1e",
		"activityBar.background": "#1e8e1e",
		"activityBar.foreground": "#e7e7e7",
		"activityBar.inactiveForeground": "#e7e7e799",
		"activityBarBadge.background": "#2c2cd3",
		"activityBarBadge.foreground": "#e7e7e7",
		"commandCenter.border": "#e7e7e799",
		"sash.hoverBorder": "#1e8e1e",
		"statusBar.background": "#156415",
		"statusBar.foreground": "#e7e7e7",
		"statusBarItem.hoverBackground": "#1e8e1e",
		"statusBarItem.remoteBackground": "#156415",
		"statusBarItem.remoteForeground": "#e7e7e7",
		"titleBar.activeBackground": "#156415",
		"titleBar.activeForeground": "#e7e7e7",
		"titleBar.inactiveBackground": "#15641599",
		"titleBar.inactiveForeground": "#e7e7e799"
	},
		"todo-tree.ripgrep.ripgrep":"/usr/bin/rg",

	"todo-tree.general.tags": [
		"TODO",
		"FIX",
		"FIXIT",
		"BUG",
		"HACK",
		"NOTE",
		"OPTIMIZE",
		"PERF",
		"REVIEW",
		"XXX",
		"WARNING",
		"DEPRECATED"
	],

	"todo-tree.regex.regex": "(//|#|<!--|;|/\\*|^|\\*)\\s*(@)?($TAGS)\\b[:]?",
	"todo-tree.regex.regexCaseSensitive": false,

	"todo-tree.highlights.enabled": true,

	"todo-tree.highlights.customHighlight": {
		"TODO": {
			"foreground": "#000000",
			"background": "#FF9800",
			"icon": "check",
			"iconColour": "#FF9800",
			"type": "text-and-comment"
		},
		"FIX": {
			"foreground": "#FFFFFF",
			"background": "#D32F2F",
			"icon": "flame",
			"iconColour": "#D32F2F",
			"type": "text-and-comment"
		},
		"FIXIT": {
			"foreground": "#FFFFFF",
			"background": "#B71C1C",
			"icon": "alert",
			"iconColour": "#B71C1C",
			"type": "text-and-comment"
		},
		"BUG": {
			"foreground": "#FFFFFF",
			"background": "#C62828",
			"icon": "bug",
			"iconColour": "#C62828",
			"type": "text-and-comment"
		},
		"HACK": {
			"foreground": "#000000",
			"background": "#FBC02D",
			"icon": "tools",
			"iconColour": "#FBC02D",
			"type": "text-and-comment"
		},
		"NOTE": {
			"foreground": "#FFFFFF",
			"background": "#1976D2",
			"icon": "note",
			"iconColour": "#1976D2",
			"type": "text-and-comment"
		},
		"OPTIMIZE": {
			"foreground": "#FFFFFF",
			"background": "#2E7D32",
			"icon": "rocket",
			"iconColour": "#2E7D32",
			"type": "text-and-comment"
		},
		"PERF": {
			"foreground": "#FFFFFF",
			"background": "#388E3C",
			"icon": "dashboard",
			"iconColour": "#388E3C",
			"type": "text-and-comment"
		},
		"REVIEW": {
			"foreground": "#000000",
			"background": "#7E57C2",
			"icon": "eye",
			"iconColour": "#7E57C2",
			"type": "text-and-comment"
		},
		"XXX": {
			"foreground": "#FFFFFF",
			"background": "#6A1B9A",
			"icon": "x",
			"iconColour": "#6A1B9A",
			"type": "text-and-comment"
		},
		"WARNING": {
			"foreground": "#000000",
			"background": "#FFC107",
			"icon": "alert",
			"iconColour": "#FFC107",
			"type": "text-and-comment"
		},
		"DEPRECATED": {
			"foreground": "#FFFFFF",
			"background": "#616161",
			"icon": "circle-slash",
			"iconColour": "#616161",
			"type": "text-and-comment"
		}
	}
}
